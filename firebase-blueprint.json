{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated learner profile, proficiency baseline, streaks, rolling scores, and cumulative metrics.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "displayName": { "type": "string" },
        "communicationLevel": { "type": "string", "enum": ["Beginner", "Intermediate", "Upper-Intermediate", "Advanced"] },
        "primaryGoal": { "type": "string" },
        "onboardingCompleted": { "type": "boolean" },
        "dailyGoalMinutes": { "type": "integer" },
        "streakDays": { "type": "integer" },
        "lastPracticeDate": { "type": "string" },
        "totalPracticeMinutes": { "type": "integer" },
        "wordsLearnedCount": { "type": "integer" },
        "recordingsCount": { "type": "integer" },
        "completedExercisesCount": { "type": "integer" },
        "fluencyScore": { "type": "integer" },
        "pronunciationScore": { "type": "integer" },
        "vocabularyScore": { "type": "integer" },
        "grammarScore": { "type": "integer" },
        "articulationScore": { "type": "integer" },
        "listeningScore": { "type": "integer" },
        "confidenceSelfRating": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "displayName", "communicationLevel", "onboardingCompleted", "createdAt", "updatedAt"]
    },
    "ProgramEnrollment": {
      "title": "ProgramEnrollment",
      "description": "User enrollment and completed days in structured learning programs.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "programId": { "type": "string" },
        "programTitle": { "type": "string" },
        "currentDay": { "type": "integer" },
        "completedDays": { "type": "array" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "programId", "programTitle", "currentDay", "completedDays", "active", "createdAt", "updatedAt"]
    },
    "DailyActivity": {
      "title": "DailyActivity",
      "description": "Daily communication practice step completion and reflection.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "dateKey": { "type": "string" },
        "completedStepIds": { "type": "array" },
        "reflectionText": { "type": "string" },
        "confidenceRating": { "type": "integer" },
        "minutesSpent": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "dateKey", "completedStepIds", "minutesSpent", "createdAt", "updatedAt"]
    },
    "UserLearningProgress": {
      "title": "UserLearningProgress",
      "description": "Lesson and module completion progress plus personalized mistake recommendations.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "lessonId": { "type": "string" },
        "moduleSlug": { "type": "string" },
        "completed": { "type": "boolean" },
        "attemptsCount": { "type": "integer" },
        "lastScore": { "type": "integer" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "lessonId", "moduleSlug", "completed", "createdAt", "updatedAt"]
    },
    "VocabularyEntry": {
      "title": "VocabularyEntry",
      "description": "Vocabulary record with IPA, collocations, spaced repetition, and AI usage assessment.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "word": { "type": "string" },
        "phonetic": { "type": "string" },
        "meaning": { "type": "string" },
        "level": { "type": "string", "enum": ["Beginner", "Intermediate", "Advanced"] },
        "synonyms": { "type": "array" },
        "antonyms": { "type": "array" },
        "exampleSentence": { "type": "string" },
        "conversationExample": { "type": "string" },
        "collocations": { "type": "array" },
        "personalNote": { "type": "string" },
        "masteryLevel": { "type": "integer" },
        "repetitions": { "type": "integer" },
        "nextReviewEpochDay": { "type": "integer" },
        "usageAssessed": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "word", "meaning", "level", "masteryLevel", "repetitions", "nextReviewEpochDay", "usageAssessed", "createdAt", "updatedAt"]
    },
    "SpeakingSession": {
      "title": "SpeakingSession",
      "description": "Recorded speaking session with local media path, WPM, confidence, and coaching report.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "moduleType": { "type": "string", "enum": ["SPEAKING_LAB", "DAILY_CHALLENGE", "PRONUNCIATION", "SHADOWING", "GRAMMAR_SPEAKING", "PRESENTATION", "LESSON_PRACTICE"] },
        "promptTitle": { "type": "string" },
        "durationSeconds": { "type": "integer" },
        "localMediaPath": { "type": "string" },
        "mediaType": { "type": "string" },
        "feedbackId": { "type": "string" },
        "transcript": { "type": "string" },
        "overallAssessment": { "type": "string" },
        "strengths": { "type": "array" },
        "mistakes": { "type": "array" },
        "pronunciationNotes": { "type": "array" },
        "betterAlternatives": { "type": "array" },
        "fillerWordsDetected": { "type": "array" },
        "repeatedExpressions": { "type": "array" },
        "improvementSuggestions": { "type": "array" },
        "recommendedExercises": { "type": "array" },
        "pronunciationAssessable": { "type": "boolean" },
        "articulationClarity": { "type": "string" },
        "thoughtOrganization": { "type": "string" },
        "nextRecommendedActivity": { "type": "string" },
        "confidenceLevel": { "type": "string", "enum": ["High", "Medium", "Low"] },
        "audioQualityNote": { "type": "string" },
        "fluencyScore": { "type": "integer" },
        "pronunciationScore": { "type": "integer" },
        "vocabularyScore": { "type": "integer" },
        "grammarScore": { "type": "integer" },
        "articulationScore": { "type": "integer" },
        "wordsPerMinute": { "type": "integer" },
        "sourceVideoUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "moduleType", "promptTitle", "durationSeconds", "overallAssessment", "confidenceLevel", "fluencyScore", "pronunciationScore", "vocabularyScore", "grammarScore", "articulationScore", "createdAt", "updatedAt"]
    },
    "SpeechFeedback": {
      "title": "SpeechFeedback",
      "description": "Granular evidence-based speech feedback linked to a speaking session.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "sessionId": { "type": "string" },
        "transcript": { "type": "string" },
        "strengths": { "type": "array" },
        "mistakes": { "type": "array" },
        "recordingExamples": { "type": "array" },
        "betterAlternatives": { "type": "array" },
        "fillerWords": { "type": "array" },
        "repeatedExpressions": { "type": "array" },
        "specificExercises": { "type": "array" },
        "pronunciationAssessable": { "type": "boolean" },
        "pronunciationNote": { "type": "string" },
        "articulationClarity": { "type": "string" },
        "thoughtOrganization": { "type": "string" },
        "nextRecommendedActivity": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "sessionId", "pronunciationAssessable", "createdAt", "updatedAt"]
    },
    "ConversationSession": {
      "title": "ConversationSession",
      "description": "AI Conversation Simulator session with scenario, proficiency adaptation, and coaching debrief.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "scenario": { "type": "string" },
        "difficultyLevel": { "type": "string" },
        "turnCount": { "type": "integer" },
        "summaryFeedback": { "type": "string" },
        "transcriptPreview": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "scenario", "difficultyLevel", "turnCount", "createdAt", "updatedAt"]
    },
    "YouTubeChannel": {
      "title": "YouTubeChannel",
      "description": "Registered YouTube channel tracked by Content Intelligence.",
      "type": "object",
      "properties": {
        "channelId": { "type": "string" },
        "handle": { "type": "string" },
        "title": { "type": "string" },
        "channelUrl": { "type": "string" },
        "videoCountSynced": { "type": "integer" },
        "status": { "type": "string", "enum": ["ACTIVE", "PAUSED", "ERROR"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["channelId", "handle", "title", "channelUrl", "status", "createdAt", "updatedAt"]
    },
    "YouTubeVideo": {
      "title": "YouTubeVideo",
      "description": "Metadata and processing status for an inspected YouTube video.",
      "type": "object",
      "properties": {
        "videoId": { "type": "string" },
        "channelId": { "type": "string" },
        "playlistId": { "type": "string" },
        "playlistTitle": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "publishedDate": { "type": "string" },
        "durationSeconds": { "type": "integer" },
        "videoUrl": { "type": "string" },
        "thumbnailUrl": { "type": "string" },
        "transcriptAvailable": { "type": "boolean" },
        "processingStatus": { "type": "string", "enum": ["EXTRACTED", "NO_CAPTIONS", "INACCESSIBLE", "PENDING", "APPROVED"] },
        "statusDetail": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["videoId", "title", "videoUrl", "transcriptAvailable", "processingStatus", "createdAt", "updatedAt"]
    },
    "VideoTranscript": {
      "title": "VideoTranscript",
      "description": "Timestamped caption segments and metadata reference for authorized source inspection.",
      "type": "object",
      "properties": {
        "videoId": { "type": "string" },
        "languageCode": { "type": "string" },
        "segmentSummaries": { "type": "array" },
        "attributionNotice": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["videoId", "languageCode", "segmentSummaries", "createdAt", "updatedAt"]
    },
    "YouTubeSource": {
      "title": "YouTubeSource",
      "description": "User-scoped YouTube source video audit entry.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "videoId": { "type": "string" },
        "channelHandle": { "type": "string" },
        "playlistTitle": { "type": "string" },
        "publishedDate": { "type": "string" },
        "durationSeconds": { "type": "integer" },
        "title": { "type": "string" },
        "videoUrl": { "type": "string" },
        "thumbnailUrl": { "type": "string" },
        "mainTopic": { "type": "string" },
        "category": { "type": "string" },
        "difficulty": { "type": "string", "enum": ["Beginner", "Intermediate", "Advanced"] },
        "extractionStatus": { "type": "string", "enum": ["EXTRACTED", "NO_CAPTIONS", "INACCESSIBLE", "PENDING"] },
        "statusDetail": { "type": "string" },
        "transcriptAvailable": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "videoId", "title", "videoUrl", "category", "difficulty", "extractionStatus", "transcriptAvailable", "createdAt", "updatedAt"]
    },
    "ExtractedTechnique": {
      "title": "ExtractedTechnique",
      "description": "Source-attributed communication technique distinguishing creator advice from AI supplements.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "videoId": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "difficulty": { "type": "string", "enum": ["Beginner", "Intermediate", "Advanced"] },
        "creatorAdvice": { "type": "string" },
        "aiExplanation": { "type": "string" },
        "originalContext": { "type": "string" },
        "instructions": { "type": "string" },
        "practicalExercise": { "type": "string" },
        "expectedOutcome": { "type": "string" },
        "suggestedDurationMinutes": { "type": "integer" },
        "commonMistake": { "type": "string" },
        "correction": { "type": "string" },
        "sourceVideoTitle": { "type": "string" },
        "sourceVideoUrl": { "type": "string" },
        "timestampLabel": { "type": "string" },
        "isCreatorDerived": { "type": "boolean" },
        "moderationStatus": { "type": "string", "enum": ["PENDING_REVIEW", "APPROVED", "PUBLISHED", "REJECTED"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "category", "difficulty", "creatorAdvice", "practicalExercise", "sourceVideoTitle", "sourceVideoUrl", "createdAt", "updatedAt"]
    },
    "LearningModule": {
      "title": "LearningModule",
      "description": "Structured curriculum module grouping lessons and exercises.",
      "type": "object",
      "properties": {
        "slug": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "orderIndex": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["slug", "title", "category", "orderIndex", "createdAt", "updatedAt"]
    },
    "Lesson": {
      "title": "Lesson",
      "description": "Interactive lesson with objective, source timestamp, instructions, practice activity, and next lesson.",
      "type": "object",
      "properties": {
        "moduleSlug": { "type": "string" },
        "techniqueId": { "type": "string" },
        "title": { "type": "string" },
        "objective": { "type": "string" },
        "sourceVideoUrl": { "type": "string" },
        "timestampLabel": { "type": "string" },
        "explanation": { "type": "string" },
        "instructions": { "type": "array" },
        "example": { "type": "string" },
        "practicePrompt": { "type": "string" },
        "nextLessonId": { "type": "string" },
        "isCreatorDerived": { "type": "boolean" },
        "status": { "type": "string", "enum": ["DRAFT", "PUBLISHED", "ARCHIVED"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["moduleSlug", "title", "objective", "sourceVideoUrl", "practicePrompt", "status", "createdAt", "updatedAt"]
    },
    "CommunicationExercise": {
      "title": "CommunicationExercise",
      "description": "Targeted communication drill linked to a module or lesson.",
      "type": "object",
      "properties": {
        "moduleSlug": { "type": "string" },
        "lessonId": { "type": "string" },
        "title": { "type": "string" },
        "instructions": { "type": "string" },
        "difficulty": { "type": "string", "enum": ["Beginner", "Intermediate", "Advanced"] },
        "durationSeconds": { "type": "integer" },
        "isAiSupplement": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["moduleSlug", "title", "instructions", "difficulty", "durationSeconds", "createdAt", "updatedAt"]
    },
    "LearningChallenge": {
      "title": "LearningChallenge",
      "description": "Daily or weekly timed communication challenge.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "challengeType": { "type": "string", "enum": ["DAILY", "WEEKLY"] },
        "durationSeconds": { "type": "integer" },
        "prompt": { "type": "string" },
        "frameworkHint": { "type": "string" },
        "sourceReference": { "type": "string" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "challengeType", "durationSeconds", "prompt", "active", "createdAt", "updatedAt"]
    },
    "RealWorldTaskRecord": {
      "title": "RealWorldTaskRecord",
      "description": "Completion log and reflection for real-world communication assignments.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "taskTitle": { "type": "string" },
        "sourceVideoUrl": { "type": "string" },
        "completed": { "type": "boolean" },
        "reflection": { "type": "string" },
        "linkedSessionId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "taskTitle", "completed", "createdAt", "updatedAt"]
    },
    "ApplicationRelease": {
      "title": "ApplicationRelease",
      "description": "Signed Android release metadata for in-app update checking and verification.",
      "type": "object",
      "properties": {
        "versionName": { "type": "string" },
        "versionCode": { "type": "integer" },
        "channel": { "type": "string", "enum": ["stable", "beta"] },
        "releaseDate": { "type": "string" },
        "releaseNotes": { "type": "string" },
        "features": { "type": "array" },
        "bugFixes": { "type": "array" },
        "securityImprovements": { "type": "array" },
        "downloadUrl": { "type": "string" },
        "installerFileName": { "type": "string" },
        "fileSizeBytes": { "type": "integer" },
        "sha256Checksum": { "type": "string" },
        "signingCertSha256": { "type": "string" },
        "minSupportedVersion": { "type": "string" },
        "minSdk": { "type": "integer" },
        "mandatory": { "type": "boolean" },
        "enabled": { "type": "boolean" },
        "supportedOs": { "type": "array" },
        "downloadCount": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["versionName", "versionCode", "channel", "releaseDate", "releaseNotes", "downloadUrl", "sha256Checksum", "minSupportedVersion", "mandatory", "enabled", "createdAt", "updatedAt"]
    },
    "ApplicationUpdateEvent": {
      "title": "ApplicationUpdateEvent",
      "description": "Audit log of update check, verification, install, and recovery events.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "fromVersion": { "type": "string" },
        "toVersion": { "type": "string" },
        "channel": { "type": "string" },
        "status": { "type": "string", "enum": ["CHECKED", "DOWNLOADED", "VERIFIED", "INSTALL_LAUNCHED", "INSTALLED", "FAILED", "ROLLED_BACK"] },
        "detail": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "fromVersion", "toVersion", "status", "createdAt"]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Server-provisioned administrator access record.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["ADMIN", "MODERATOR"] },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "role", "active", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": { "schema": { "$ref": "#/entities/UserProfile" } },
    "/users/{userId}/enrollments/{programId}": { "schema": { "$ref": "#/entities/ProgramEnrollment" } },
    "/users/{userId}/dailyActivities/{dateId}": { "schema": { "$ref": "#/entities/DailyActivity" } },
    "/users/{userId}/learningProgress/{progressId}": { "schema": { "$ref": "#/entities/UserLearningProgress" } },
    "/users/{userId}/vocabulary/{wordId}": { "schema": { "$ref": "#/entities/VocabularyEntry" } },
    "/users/{userId}/speakingSessions/{sessionId}": { "schema": { "$ref": "#/entities/SpeakingSession" } },
    "/users/{userId}/speechFeedback/{feedbackId}": { "schema": { "$ref": "#/entities/SpeechFeedback" } },
    "/users/{userId}/conversationSessions/{sessionId}": { "schema": { "$ref": "#/entities/ConversationSession" } },
    "/users/{userId}/youtubeSources/{sourceId}": { "schema": { "$ref": "#/entities/YouTubeSource" } },
    "/users/{userId}/extractedTechniques/{techniqueId}": { "schema": { "$ref": "#/entities/ExtractedTechnique" } },
    "/users/{userId}/realWorldTasks/{taskId}": { "schema": { "$ref": "#/entities/RealWorldTaskRecord" } },
    "/adminUsers/{userId}": { "schema": { "$ref": "#/entities/AdminUser" } },
    "/youtubeChannels/{channelId}": { "schema": { "$ref": "#/entities/YouTubeChannel" } },
    "/youtubeVideos/{videoId}": { "schema": { "$ref": "#/entities/YouTubeVideo" } },
    "/videoTranscripts/{videoId}": { "schema": { "$ref": "#/entities/VideoTranscript" } },
    "/extractedTechniques/{techniqueId}": { "schema": { "$ref": "#/entities/ExtractedTechnique" } },
    "/learningModules/{moduleId}": { "schema": { "$ref": "#/entities/LearningModule" } },
    "/lessons/{lessonId}": { "schema": { "$ref": "#/entities/Lesson" } },
    "/communicationExercises/{exerciseId}": { "schema": { "$ref": "#/entities/CommunicationExercise" } },
    "/learningChallenges/{challengeId}": { "schema": { "$ref": "#/entities/LearningChallenge" } },
    "/applicationReleases/{releaseId}": { "schema": { "$ref": "#/entities/ApplicationRelease" } },
    "/applicationUpdateEvents/{eventId}": { "schema": { "$ref": "#/entities/ApplicationUpdateEvent" } }
  }
}
