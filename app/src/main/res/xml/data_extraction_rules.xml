<?xml version="1.0" encoding="utf-8"?>
<!--
   Data extraction rules for Android 12 and higher (API >= 31).
   Enforces include-only cloud-backup and device-transfer per ADR-015, D-23, and SEC-01 §6.3.
   Only non-sensitive learning.db and preferences are included.
   Audio recordings and sensitive transcripts stay strictly on device and are never backed up or transferred.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="learning.db" />
        <include domain="file" path="datastore/settings.preferences_pb" />
        <include domain="file" path="datastore/speakcraft_prefs.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="learning.db" />
        <include domain="file" path="datastore/settings.preferences_pb" />
        <include domain="file" path="datastore/speakcraft_prefs.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
