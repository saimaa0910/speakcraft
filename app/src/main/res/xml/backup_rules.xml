<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules for Android 11 and lower (API <= 30).
   Enforces include-only backup per ADR-015, D-23, and SEC-01 §6.3.
   Only non-sensitive learning.db and preferences are included.
   Audio recordings and sensitive transcripts stay strictly on device and are never backed up.
-->
<full-backup-content>
    <include domain="database" path="learning.db" />
    <include domain="file" path="datastore/settings.preferences_pb" />
    <include domain="file" path="datastore/speakcraft_prefs.preferences_pb" />
</full-backup-content>
